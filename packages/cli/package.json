{
  "name": "tokengator",
  "version": "0.0.0",
  "description": "Tokengator command line tools.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tokengator/tokengator",
    "directory": "packages/cli"
  },
  "bin": {
    "tokengator": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b --noEmit",
    "dev": "bun run ./src/cli.ts",
    "generate:api": "bun run ./scripts/generate-api-client.ts",
    "pack:npm": "bun pm pack --quiet --destination \"${PACK_DEST:-.}\"",
    "test": "bun test ./test"
  },
  "dependencies": {
    "@better-auth/api-key": "catalog:",
    "@clack/prompts": "^1.2.0",
    "@solana/kit": "catalog:",
    "better-auth": "catalog:",
    "better-auth-solana": "catalog:",
    "commander": "^14.0.3",
    "env-paths": "^4.0.0",
    "picocolors": "^1.1.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hey-api/client-fetch": "0.13.1",
    "@hey-api/openapi-ts": "0.97.1",
    "@tokengator/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
