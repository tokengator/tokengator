{
  "name": "@tokengator/workspace",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@better-auth/api-key": "1.6.5",
      "@libsql/client": "0.17.2",
      "@logtape/hono": "2.0.7",
      "@logtape/logtape": "2.0.7",
      "@orpc/client": "1.14.2",
      "@orpc/openapi": "1.14.2",
      "@orpc/server": "1.14.2",
      "@orpc/zod": "1.14.2",
      "@solana/kit": "6.9.0",
      "@types/bun": "1.3.13",
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3",
      "@wallet-ui/react": "4.1.0",
      "better-auth": "1.6.5",
      "better-auth-solana": "1.0.0",
      "discord.js": "14.26.4",
      "dotenv": "17.4.2",
      "drizzle-orm": "0.45.2",
      "hono": "4.12.18",
      "libsql": "0.5.29",
      "lucide-react": "1.14.0",
      "next-themes": "0.4.6",
      "ogl": "1.0.11",
      "react": "19.2.6",
      "react-dom": "19.2.6",
      "sonner": "2.0.7",
      "superjson": "2.2.6",
      "tailwindcss": "4.2.4",
      "tsdown": "0.22.0",
      "typescript": "5.9.3",
      "zod": "4.3.6"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "changeset": "changeset",
    "check-types": "turbo check-types",
    "ci": "bun run lint && turbo run build check-types test test:e2e test:integration",
    "cli": "bun run --cwd packages/cli ./src/cli.ts",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:local": "bun run --cwd packages/db db:local",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "db:push": "bun run --cwd packages/db db:push",
    "db:reset": "rm packages/db/local.db*",
    "db:seed": "bun run cli seed apply scripts/default-dev-seed.json",
    "db:studio": "bun run --cwd packages/db db:studio",
    "dev": "turbo dev",
    "dev:api": "bun --bun run --cwd apps/api dev",
    "dev:web": "bun --bun run --cwd apps/web dev",
    "docker:build": "docker build --target app -t tokengator-app:test .",
    "docker:up": "docker compose --env-file apps/api/.env --env-file apps/api/.env.docker up --build",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "pack:packages": "bun run --filter '*' pack:npm",
    "prestart:api": "bun run build && bun db:migrate",
    "ruler:apply": "bun x ruler apply --local-only",
    "setup": "bun run ./scripts/setup.ts",
    "start:api": "bun --bun run --cwd apps/api start",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:integration": "turbo run test:integration",
    "version": "changeset version"
  },
  "dependencies": {
    "@tokengator/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@tokengator/config": "workspace:*",
    "@types/bun": "catalog:",
    "eslint-plugin-perfectionist": "5.9.0",
    "lefthook": "2.1.6",
    "oxfmt": "0.50.0",
    "oxlint": "1.65.0",
    "pkg-pr-new": "0.0.78",
    "turbo": "2.9.14",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.13"
}
